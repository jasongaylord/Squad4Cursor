{
  "name": "@squad4cursor/cli",
  "version": "0.2.0",
  "description": "CLI for Squad4Cursor — init, doctor, upgrade, watch, PRD, and shared .squad/ state",
  "type": "module",
  "bin": {
    "s4c": "./dist/cli-entry.js",
    "squad4cursor": "./dist/cli-entry.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-templates.mjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/init.test.ts src/phase-b.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@squad4cursor/sdk": "0.2.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
